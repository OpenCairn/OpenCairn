# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~

# Obsidian
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/
.obsidian/community-plugins.json

# Claude Code internal
.claude/plans/
.claude/todos/
.claude/settings.json
.claude/settings.local.json
.claude/hooks/

# Temporary files
*.tmp
*.bak

# Lock files from locked-edit.sh / write-tickler.sh, which write `.<basename>.lock`
# beside their target — so a locked edit to any tracked file leaves one here.
# Keep the leading dot: `*.lock` would swallow package-lock.json, Cargo.lock, etc.
.*.lock

# Python bytecode (importing a script for testing writes these next to it,
# and a bulk `git add .claude/scripts/` would otherwise stage them)
__pycache__/
*.pyc

# Personal commands (not for public template)
.claude/commands/sync-template.md
.claude/commands/ralph.md
